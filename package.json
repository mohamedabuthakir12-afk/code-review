{
  "name": "code-review-agent",
  "version": "0.1.0",
  "description": "In-house LLM + static-analysis code review bot (SonarQube + CodeRabbit replacement)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "dry-run": "tsx src/devtools/dryRun.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@octokit/webhooks": "^14.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^4.77.0",
    "parse-diff": "^0.11.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
