# GitHub App / webhook credentials
GITHUB_WEBHOOK_SECRET=changeme
GITHUB_TOKEN=ghp_xxx

# Self-hosted LLM (OpenAI-API-compatible server: Ollama, vLLM, llama.cpp
# server, TGI, LM Studio, ...). No code or diff content leaves this host.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-coder:14b
LLM_REQUEST_TIMEOUT_MS=60000

# Server
PORT=3000

# Static analysis
# Path to semgrep binary if not on PATH; leave unset to skip semgrep and rely on the LLM layer only
SEMGREP_BIN=semgrep

# Company-specific review guidelines, loaded fresh on every review run
REVIEW_STANDARDS_PATH=config/review-standards.md

# Tuning
MAX_CONCURRENT_LLM_CALLS=4
MAX_HUNKS_PER_LLM_CALL=6
MAX_HUNKS_PER_PR=150
